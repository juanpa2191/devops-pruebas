{
  "name": "taller-motos-api",
  "version": "1.0.0",
  "description": "API para gestion de reparaciones y repuestos de motocicletas, con arquitectura en capas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "smoke-test": "node scripts/smoke-test.js"
  },
  "keywords": [
    "motos",
    "taller",
    "reparaciones",
    "repuestos", 
    "nodejs",
    "arquitectura-en-capas"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.4"
  }
}
